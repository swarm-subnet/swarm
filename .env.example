# Swarm Subnet Configuration
# Copy this file to .env and set your values

# =============================================================================
# REQUIRED FOR VALIDATORS
# =============================================================================

# Backend API URL (validators only — miners submit via chain, no URL needed)
SWARM_BACKEND_API_URL=URL_HERE

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Wandb API Key for logging (distributed separately to validators)
WANDB_API_KEY=your_wandb_api_key_here

# Custom validator name (defaults to validator-{uid})
VALIDATOR_NAME=validator-name

# Wandb Project settings (already configured in code)
# PROJECT: validator-logs
# ENTITY: swarm-subnet-swarm
# URL: https://wandb.ai/swarm-subnet-swarm/validator-logs

# =============================================================================
# VALIDATOR CONTAINER (docker compose --profile validator up -d validator)
# =============================================================================

# Wallet the validator signs with. Both are required.
SWARM_WALLET_NAME=my_cold
SWARM_WALLET_HOTKEY=my_validator

# Subnet and chain. Defaults are the live ones; override only for a test network.
SWARM_NETUID=124
SWARM_SUBTENSOR_NETWORK=finney
# SWARM_SUBTENSOR_CHAIN_ENDPOINT=wss://your.endpoint
# SWARM_LOGGING=debug

# Which image to run. Pin SWARM_VALIDATOR_TAG to a version to stop auto-updating.
SWARM_VALIDATOR_IMAGE=ghcr.io/swarm-subnet/swarm-validator
SWARM_VALIDATOR_TAG=latest

# Who the container runs as, and where it keeps state. The state path is used
# unchanged on both sides of the mount, so leave it absolute.
SWARM_UID=1000
SWARM_GID=1000
DOCKER_GID=999
SWARM_STATE_DIR=/opt/swarm-validator-state
BT_WALLET_HOME=/root/.bittensor

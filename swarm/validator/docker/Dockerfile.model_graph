# syntax=docker/dockerfile:1
FROM python:3.11.13-slim-bookworm@sha256:86adf8dbadc3d6e82ee5dd2c74bec2e1c2467cdad47886280501df722372d2e1

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    SWARM_MODEL_GRAPH_ARTIFACT=/workspace/model_graph.zip

RUN useradd --create-home --uid 1000 evaluator && \
    mkdir -p /workspace /app && \
    chown -R evaluator:evaluator /workspace /app

COPY swarm/validator/docker/model-graph-requirements.lock /tmp/requirements.lock
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --no-deps --require-hashes -r /tmp/requirements.lock

COPY swarm/__init__.py /app/swarm/__init__.py
COPY swarm/model_graph /app/swarm/model_graph
COPY swarm/submission_template /app/swarm/submission_template

USER evaluator
WORKDIR /workspace
EXPOSE 8000

CMD ["python", "/app/swarm/submission_template/main.py"]

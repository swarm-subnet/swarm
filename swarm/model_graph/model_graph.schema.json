{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "swarm://model_graph.v1",
  "title": "Swarm model-graph artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_graph_version",
    "family_id",
    "execution_profile",
    "runner_abi",
    "models",
    "nodes",
    "action"
  ],
  "properties": {
    "model_graph_version": { "const": "model_graph.v1" },
    "family_id": {
      "enum": [
        "cf_autopilot",
        "cf_search_and_rescue",
        "cf_swarm_autopilot",
        "cf_swarm_sar",
        "cf_interceptor"
      ]
    },
    "execution_profile": { "const": "swarm.onnx-neural.cpu.v1" },
    "runner_abi": { "const": "graph_runner.v1" },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "sha256"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "file": {
            "type": "string",
            "pattern": "^models/[A-Za-z0-9_.-]{1,80}\\.onnx$"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "memory": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "shape", "writer"],
        "properties": {
          "name": { "$ref": "#/$defs/identifier" },
          "shape": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "oneOf": [
                { "type": "integer", "minimum": 1 },
                { "const": "N" }
              ]
            }
          },
          "writer": { "$ref": "#/$defs/nodeOutputRef" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "model", "inputs"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "model": { "$ref": "#/$defs/identifier" },
          "inputs": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 16,
            "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_.:/-]{0,63}$" },
            "additionalProperties": { "$ref": "#/$defs/bindingRef" }
          },
          "every_n_steps": { "type": "integer", "minimum": 1, "maximum": 256 }
        }
      }
    },
    "action": { "$ref": "#/$defs/nodeOutputRef" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
    "nodeOutputRef": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}\\.[A-Za-z_][A-Za-z0-9_.:/-]{0,63}$"
    },
    "bindingRef": {
      "type": "string",
      "pattern": "^(obs\\.[A-Za-z][A-Za-z0-9_]{0,63}|memory\\.[A-Za-z][A-Za-z0-9_]{0,63}|[A-Za-z][A-Za-z0-9_]{0,63}\\.[A-Za-z_][A-Za-z0-9_.:/-]{0,63})$"
    }
  }
}
